NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://tracker:tracker@127.0.0.1:55432/tracker
# Supabase/Vercel runtime: use the Supabase Shared Pooler transaction URL.
# DATABASE_URL=postgres://postgres.<project-ref>:[password]@[region].pooler.supabase.com:6543/postgres?sslmode=require
# Controlled migration connection; use a direct or session-pooler URL, never the runtime transaction URL.
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=postgres://tracker:tracker@127.0.0.1:55433/tracker_test
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
# Vercel runtime must use DB_POOL_MAX=1 with the Supabase transaction pooler.
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
JWT_SECRET=change-this-development-secret-to-a-long-random-value
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=28800000
COOKIE_SECRET=change-this-development-cookie-secret
CSRF_SECRET=change-this-development-csrf-secret
BCRYPT_ROUNDS=12
LOGIN_RATE_MAX=8
LOGIN_RATE_WINDOW_MS=900000
SEED_ADMIN_PASSWORD=Admin-dev-password-2026!
SEED_HR_PASSWORD=Hr-dev-password-2026!
SEED_USER_PASSWORD=User-dev-password-2026!
SEED_READONLY_PASSWORD=Readonly-dev-password-2026!
